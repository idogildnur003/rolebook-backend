MONGO_URI=mongodb://localhost:27017
# Prod Mongo is private (no public TCP proxy). External access — Compass, and
# the cmd/migrate-* scripts run from your machine — goes through the Tailscale
# gateway. From a device on the tailnet, connect with:
#   mongodb://<user>:<pass>@rolebook-gateway.<your-tailnet>.ts.net:27017/?directConnection=true&authSource=admin
JWT_SECRET=Secret1234567890
# Server listen port (default 3000). The -port CLI flag overrides this: ./server -port 8080
PORT=3000

AWS_ENDPOINT_URL=http://localhost:9000
AWS_REGION=us-east-1
AWS_S3_BUCKET=rolebook-avatars
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Use S3 path-style addressing (true/1/yes/on). Required for MinIO and other
# S3-compatible stores in local dev. Default off — real AWS uses virtual-hosted.
AWS_S3_FORCE_PATH_STYLE=

# Comma-separated user IDs allowed to manage the global arsenal catalog images
# (admin-only). Empty = nobody is admin.
ADMIN_USER_IDS=

# Email verification (Resend). Leave RESEND_API_KEY empty for local dev: emails
# are not sent, verification codes are printed to the server log, and email
# verification is skipped entirely (Register issues a token directly).
RESEND_API_KEY=
# Sender address; needs a Resend-verified domain in production. Falls back to
# Resend's onboarding@resend.dev sender when empty.
EMAIL_FROM=
# Override the OTP gate. Defaults to on when RESEND_API_KEY is set, off when not.
# Set to true to exercise the full code flow locally (codes go to the log).
EMAIL_VERIFICATION_ENABLED=

# Rate limiting. Master switch defaults ON — set to false/0/no/off to disable
# entirely (e.g. load testing). Three tiers apply automatically to every route:
#   - Global: per-IP floor over the whole /api surface.
#   - User:   per-authenticated-user limit on protected routes.
#   - Auth:   tighter per-IP limit on the public auth routes (brute-force/spam).
RATE_LIMIT_ENABLED=
# When set, limiter counters live in Redis (shared across restarts/instances,
# with a local in-memory fallback if Redis is unreachable). Leave empty for local
# dev / CI to use a per-process in-memory counter. Use the private URL in prod:
#   redis://default:<password>@<service>.railway.internal:6379
REDIS_URL=
# Requests allowed per window, per key, for each tier. Windows accept Go duration
# syntax (e.g. 1m, 30s). Defaults shown; tune from observed 429 rates.
RATE_LIMIT_GLOBAL_REQUESTS=600
RATE_LIMIT_GLOBAL_WINDOW=1m
RATE_LIMIT_USER_REQUESTS=300
RATE_LIMIT_USER_WINDOW=1m
RATE_LIMIT_AUTH_REQUESTS=10
RATE_LIMIT_AUTH_WINDOW=1m
