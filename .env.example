MONGO_URI=mongodb://localhost:27017
JWT_SECRET=Secret1234567890
PORT=3000

AWS_ENDPOINT_URL=http://localhost:9000
AWS_REGION=us-east-1
AWS_S3_BUCKET=rolebook-avatars
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Email verification (Resend). Leave RESEND_API_KEY empty for local dev: emails
# are not sent, verification codes are printed to the server log, and email
# verification is skipped entirely (Register issues a token directly).
RESEND_API_KEY=
# Sender address; needs a Resend-verified domain in production. Falls back to
# Resend's onboarding@resend.dev sender when empty.
EMAIL_FROM=
# Override the OTP gate. Defaults to on when RESEND_API_KEY is set, off when not.
# Set to true to exercise the full code flow locally (codes go to the log).
EMAIL_VERIFICATION_ENABLED=
